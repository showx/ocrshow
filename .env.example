# 本机密钥与覆盖项。复制为 .env 后填写，切勿提交到 GitHub。
# 优先级高于 config.toml。留空表示不覆盖。

# OCR_DEVICE=gpu
# OCR_ADDR=:8080
# OCR_DATA=data
# OCR_IMAGES=samples
# OCR_OUT=output
# OCR_PYTHON=
# OCR_FRONTEND=
# OCR_VL_HOST=http://127.0.0.1:11434
# OCR_VL_MODEL=qwen3-vl:8b
# OCR_SKIP_VL=0

# Web 登录（覆盖 config.toml 里的同名账号）。都不配且库是空的时，默认 admin / ocrshow。
# OCR_AUTH_USER=admin
# OCR_AUTH_PASSWORD=

# 若改用云端视觉模型，把密钥写在这里：
# OCR_VL_API_KEY=
